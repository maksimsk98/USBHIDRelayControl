  <!--
    Do NOT enable WholeProgramOptimization (/GL) on this static lib.
    Packaging /GL objs (especially spdlog's large TUs) into a .lib and then
    LTCG-linking the consumer triggers MSVC LNK1179 "duplicate COMDAT" inside
    spdlog.obj. PeakExpertNoGUI can still use /LTCG on its own code; 3rdparty
    objects simply participate as regular COFF.
  -->
  <PropertyGroup Condition="'$(Configuration)'=='Release' or '$(Configuration)'=='MinSizeRel'">
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
