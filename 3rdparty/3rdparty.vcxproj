      Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
      Label="LocalAppDataPlatform" />
  </ImportGroup>
  <!-- Shared ClCompile CRT/language/ABI macros - PeakExpertCE.Common.props -->
  <Import Project="$(ProjectDir)..\USBHIDRelayControl.Common.props" />
  <PropertyGroup Label="UserMacros" />
  <!--
    Keep .lib/.pdb under this project - never in PeakExpertNoGUI's deploy OutDir
    (shared solution $(Platform)\$(Configuration) would otherwise collect them).
    ProjectReference still passes TargetPath to the linker correctly.
  -->
  <PropertyGroup>
    <OutDir>$(ProjectDir)$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>

  <!--
    3rdparty-only ClCompile. Shared CRT/language/ABI macros come from
    PeakExpertCE.Common.props. HAVE_CONFIG_H is rabbitmq-c specific
    (config.h); harmless for the other libraries in this static lib.
  -->
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>HAVE_CONFIG_H;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>
        $(ProjectDir);
        $(ProjectDir)rabbitmq-c;
        $(ProjectDir)rabbitmq-c\deprecated;
        $(ProjectDir)boost;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>

  <!--
    ============================================================================
    rabbitmq-c 0.17.0
    Source:      https://github.com/alanxz/rabbitmq-c
    Downloaded:  C:\Users\SemykinVD\Downloads\rabbitmq-c-0.17.0

    Built WITHOUT SSL/AMQPS support: amqp_openssl.c / amqp_openssl_bio.* and the
    win32\threads.* SSL locking shim are intentionally not included.
    PeakExpertNoGUI only ever calls the plain AmqpClient::Channel::Create()
    overload (never OpenSecureChannel/amqp_ssl_socket_*), so this doesn't lose
    any used functionality and avoids pulling in OpenSSL as a dependency.
    config.h is hand-written (not CMake-generated) - see its own comments.
