{
  "name": "ПикЭкспертКЭФ",
  "version": "0.1.2",
  "private": true,
  "main": "main.js",
  "dependencies": {
    "electron": "^38.4.0",
    "electron-store": "^11.0.2",
    "html-to-docx": "^1.8.0",
    "moment-timezone": "^0.5.45",
    "sanitize-filename": "^1.6.4",
    "winston": "^3.13.0",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "concurrently \"npm run client\" \"npm run server:dev\"",
    "build": "node ./scripts/writeVersion.js && vite build",
    "test": "cross-env HEADLESS=true playwright test  --config=testing/playwright/configs/playwright.electron.config.js",
    "test:slow": "cross-env SLOW_MO=1000 playwright test --config=testing/playwright/configs/playwright.electron.config.js",
    "test:headed": "playwright test --config=testing/playwright/configs/playwright.electron.config.js --headed",
    "test:debug": "playwright test --config=testing/playwright/configs/playwright.electron.config.js --debug",
    "explore:chrome": "cross-env EXPLORE=true npx playwright test --config=testing/playwright/configs/playwright.chromium.config.js --headed --debug testing/playwright/tests/chrome/exploration-chrome.spec.js",
    "explore:electron": "cross-env EXPLORE=true npx playwright test --config=testing/playwright/configs/playwright.electron.config.js --headed --debug testing/playwright/tests/electron/exploration-electron.spec.js",
    "explore:chrome:dad": "cross-env EXPLORE=true npx playwright test --config=testing/playwright/configs/playwright.chromium.config.js --headed --debug testing/playwright/tests/chrome/dad-exploration.js",
    "test:chrome": "playwright test --config=testing/playwright/configs/playwright.chromium.config.js",
    "test:chrome:slow": "cross-env SLOW_MO=1000 playwright test --config=testing/playwright/configs/playwright.chromium.config.js --headed",
    "quickTest": "cross-env HEADLESS=true PW_WORKERS=70% node scripts/quickTest.js",
    "quickTest:regression": "cross-env HEADLESS=true REGRESSION=true SUPPRESS_TEST_LOGS=true PW_WORKERS=70% node scripts/quickTest.js",
    "quickTest:regression:logged": "cross-env HEADLESS=true REGRESSION=true PW_WORKERS=70% node scripts/quickTest.js",
    "test:regression": "cross-env HEADLESS=true REGRESSION=true SUPPRESS_TEST_LOGS=true INFRA_CHECK=true SKIP_E2E=true SKIP_OK=true PW_WORKERS=70% playwright test --config=testing/playwright/configs/playwright.electron.config.js",
    "test:regression:logged": "cross-env HEADLESS=true REGRESSION=true INFRA_CHECK=true SKIP_E2E=true SKIP_OK=true PW_WORKERS=70% playwright test --config=testing/playwright/configs/playwright.electron.config.js",
    "test:regression:e2e": "cross-env HEADLESS=true REGRESSION=true E2E_ONLY=true PW_WORKERS=1 playwright test --config=testing/playwright/configs/playwright.electron.config.js",
    "test:specs": "cross-env INFRA_CHECK=true HEADLESS=true PW_WORKERS=1 playwright test --config=testing/playwright/configs/playwright.electron.config.js testing/playwright/tests/electron/specs/",
    "testReport": "playwright show-report playwright-report/electron",
    "bench:workers": "node scripts/benchWorkers.js",
    "quickTest:headed": "cross-env PW_WORKERS=1 node scripts/quickTest.js",
    "quickTest:slow": "cross-env SLOW_MO=1000 PW_WORKERS=1 node scripts/quickTest.js",
    "record:trace": "node scripts/record-trace",
    "record:inspector": "npx playwright codegen http://localhost:5000",
    "record:inspector:dev": "npx playwright codegen http://localhost:3000",
    "lint": "eslint src/ electron/ main.js preload.js",
    "lint:staged-errors-only": "npx lint-staged --quiet",
    "lint:all": "eslint src/ electron/ testing/ main.js preload.js",
    "eslint": "eslint",
    "eslint:fix": "eslint --fix",
    "eslint:fix-all": "eslint src/ electron/ testing/ main.js preload.js --fix",
    "eslint:summary": "eslint src/ electron/ main.js preload.js --format stylish --max-warnings 1000",
    "eslint:summary:all": "eslint src/ electron/ testing/ main.js preload.js --format stylish --max-warnings 1000",
    "eslint:json": "eslint src/ electron/ main.js preload.js --format json --output-file eslint-report.json && echo 'Report saved to eslint-report.json'",
    "eslint:json:all": "eslint src/ electron/ testing/ main.js preload.js --format json --output-file eslint-report.json && echo 'Report saved to eslint-report.json'",
    "eslint:top": "node scripts/eslint-top.js",
    "eslint:worst": "node scripts/eslint-worst.js",
    "eslint:specific": "node scripts/eslint-specific.js",
    "client": "vite",
    "server": "node ./src/server/server.js",
    "server:dev": "cross-env NODE_ENV=development nodemon ./src/server/server.js",
    "server_debug": "cross-env NODE_ENV=debug node ./src/server/server.js",
    "start_electron": "electron .",
    "start_electron_dev": "cross-env ELECTRON_DEV=1 electron .",
    "start_electron_testing": "cross-env TESTING=true OPEN_DEVTOOLS_ON_START=true electron .",
    "start:electron:debug": "cross-env TESTING=true electron . --remote-debugging-port=9222",
    "build:server": "node scripts/bundle-server.js",
    "build:all": "npm run build && npm run build:server",
    "dist:prepare": "node scripts/prepare-dist.js",
    "dist:full": "npm run build:all && npm run dist:prepare",
    "electron:dev": "cross-env ELECTRON_DEV=1 electron .",
    "archive": "node ./scripts/prepare-archive.js"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --quiet"
    ]
  },
  "devDependencies": {
    "@eslint/create-config": "^1.0.3",
    "@eslint/eslintrc": "^3.0.2",
    "@eslint/js": "^9.2.0",
    "@playwright/test": "^1.58.2",
    "@reduxjs/toolkit": "^2.2.3",
    "@szhsin/react-menu": "^4.2.2",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@turbodocx/html-to-docx": "^1.18.1",
    "@vitejs/plugin-react": "^4.4.1",
    "allotment": "^1.20.2",
    "amqplib": "^0.10.4",
    "archiver": "^7.0.1",
    "axios": "^1.7.2",
    "bootstrap": "^5.3.3",
    "concurrently": "^8.2.2",
    "connect-timeout": "^1.9.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dockview": "^5.2.0",
    "docx": "^8.5.0",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-unused-imports": "^4.3.0",
    "express": "^4.19.2",
    "file-saver": "^2.0.5",
    "fs-extra": "^11.3.3",
    "glob": "^13.0.4",
    "globals": "^15.1.0",
    "html-docx-js": "^0.3.1",
    "http-proxy-middleware": "^3.0.0",
    "husky": "^9.1.7",
    "idb": "^8.0.3",
    "lint-staged": "^16.4.0",
    "lodash": "^4.17.21",
    "multer": "^1.4.5-lts.1",
    "nodemon": "^3.1.0",
    "pdfmake": "^0.2.12",
    "plotly.js-cartesian-dist": "^3.0.0",
    "plotly.js-locales": "^3.0.0",
    "rc-tree": "^5.13.1",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.2",
    "react-bootstrap-typeahead": "^6.4.1",
    "react-complex-tree": "^2.6.1",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.4.6",
    "react-plotly.js": "^2.6.0",
    "react-redux": "^9.1.0",
    "redux": "^5.0.1",
    "redux-actions": "^3.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "uuid": "^9.0.1",
    "vite": "^6.3.5",
    "vite-plugin-node-polyfills": "^0.23.0",
    "vite-plugin-svgr": "^4.3.0"
  }
}
